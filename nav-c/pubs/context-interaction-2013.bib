@INPROCEEDINGS{Chang2015context,
  bibfile = {context-interaction-2013.bib},
  author = {Moser Silva Fagundes and Felipe Meneguzzi; Renata Vieira and Rafael Bordini},
  title = {Interaction Patterns in a MAS Organisation to Support Shared Tasks},
  booktitle = {In The 8th International and Interdisciplinary Conference on Modeling and Using Context},
  year = {2013},
  pages = {364-370},
  abstract = {We aim to help the coordination of the activities of groups of users who share certain tasks. In particular, we are working towards automatically predicting the context of each user, in particular which task each user is trying to accomplish. We also intend to predict how probable it is that users will be able to successfully accomplish theirs tasks. In case a failure is likely, we help the users in negotiating task reallocation among group members. This paper presents the interaction patterns we use for information exchange among agents in order to determine the context needed to make those predictions.},
  url = {http://www.meneguzzi.eu/felipe/pubs/context-interaction-2013.pdf}
}