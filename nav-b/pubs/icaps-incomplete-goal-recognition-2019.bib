@InProceedings{PereiraPereiraMeneguzzi2019,
  bibfile = {icaps-incomplete-goal-recognition-2019.bib},
  topic = {goal-recognition},
  author =    {Ramon Fraga Pereira and Andr\'{e} Grahl Pereira and Felipe Meneguzzi},
  title =     {Landmark-Enhanced Heuristics for Goal Recognition in Incomplete Domain Models},
  booktitle = {Proceedings of the 29th International Conference on Automated Planning and Scheduling},
  year =      {2019},
  abstract =  {Recent approaches to goal recognition have progressively relaxed the assumptions about the amount and correctness of domain knowledge and available observations, yielding accurate and efficient algorithms. These approaches, however, assume completeness and correctness of the domain theory against which their algorithms match observations: this is too strong for most real-world domains. In this paper, we develop goal recognition techniques that are capable of recognizing goals using incomplete domain theories by considering different notions of planning landmarks in such domains. We evaluate the resulting techniques empirically in a large dataset of incomplete domains, and perform an ablation study to understand their effect on recognition performance. },
  url = {https://www.meneguzzi.eu/felipe/pubs/icaps-incomplete-goal-recognition-2019.pdf}
}
